{
  "name": "docsense-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "e2e:auth": "tsx --env-file-if-exists=.env scripts/auth-e2e.ts",
    "test:documents:unit": "tsx --env-file-if-exists=.env scripts/document-unit.ts",
    "test:documents:integration": "tsx --env-file-if-exists=.env scripts/document-integration.ts",
    "test:documents:e2e": "tsx --env-file-if-exists=.env scripts/document-e2e.ts",
    "test:ai:foundation": "NODE_ENV=test tsx --env-file-if-exists=.env scripts/ai-foundation-integration.ts",
    "test:ai:pdf-loader": "tsx --env-file-if-exists=.env scripts/pdf-loader-unit.ts",
    "test:ai:vlm-loader": "tsx --env-file-if-exists=.env scripts/vlm-loader-unit.ts",
    "test:ai:splitter": "tsx --env-file-if-exists=.env scripts/document-splitter-unit.ts",
    "test:ai:embeddings": "tsx --env-file-if-exists=.env scripts/embedding-retrieval-unit.ts",
    "test:ai:embeddings:integration": "NODE_ENV=test tsx --env-file-if-exists=.env scripts/embedding-retrieval-integration.ts",
    "test:ai:summary": "tsx --env-file-if-exists=.env scripts/summary-unit.ts",
    "test:ai:summary:integration": "NODE_ENV=test tsx --env-file-if-exists=.env scripts/summary-integration.ts",
    "test:ai:context": "tsx --env-file-if-exists=.env scripts/context-builder-unit.ts",
    "test:ai:context:live": "NODE_ENV=test tsx --env-file-if-exists=.env scripts/context-builder-live.ts",
    "test:ai:chat": "tsx --env-file-if-exists=.env scripts/chat-service-unit.ts",
    "e2e:sessions": "tsx --env-file-if-exists=.env scripts/session-e2e.ts",
    "e2e:comments": "tsx --env-file-if-exists=.env scripts/comments-e2e.ts",
    "test:comments:connections": "tsx --env-file-if-exists=.env scripts/comment-connection-unit.ts",
    "test:comments:broadcast-failure": "tsx --env-file-if-exists=.env scripts/comment-broadcast-failure.ts",
    "e2e:comments:websocket": "tsx --env-file-if-exists=.env scripts/comment-websocket-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@hono/node-server": "latest",
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/openai": "^1.5.11",
    "@langchain/textsplitters": "^1.0.1",
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/client": "6.19.3",
    "hono": "latest",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.1",
    "pdfjs-dist": "^6.3.289",
    "prisma": "6.19.3",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/nodemailer": "^7.0.6",
    "@types/ws": "^8.18.1",
    "tsx": "latest",
    "typescript": "latest"
  }
}
