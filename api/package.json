{
  "name": "docsense-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "e2e:auth": "tsx --env-file-if-exists=.env scripts/auth-e2e.ts",
    "test:documents:unit": "tsx --env-file-if-exists=.env scripts/document-unit.ts",
    "test:documents:integration": "tsx --env-file-if-exists=.env scripts/document-integration.ts",
    "test:documents:e2e": "tsx --env-file-if-exists=.env scripts/document-e2e.ts",
    "e2e:sessions": "tsx --env-file-if-exists=.env scripts/session-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@hono/node-server": "latest",
    "@prisma/client": "6.19.3",
    "hono": "latest",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.1",
    "prisma": "6.19.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/nodemailer": "^7.0.6",
    "tsx": "latest",
    "typescript": "latest"
  }
}
