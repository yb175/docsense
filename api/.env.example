NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docsense

# Redis (docker compose up -d redis)
REDIS_URL=redis://localhost:6379

# Required. Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Email/SMTP. For local capture use localhost:1025 and Mailpit.
# For real delivery use your provider, e.g. smtp.gmail.com:587 with an app password.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Docsense <no-reply@docsense.local>

# JWT TTL is fixed at exactly 3 days and OTP TTL at exactly 3 minutes in code.

# Private S3 storage for uploaded PDFs.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
MAX_PDF_SIZE_BYTES=10485760

# AI providers (server-side only)
OPENAI_API_KEY=
GEMINI_API_KEY=

AI_VISION_MODEL=gemini-2.5-flash-lite
AI_CHUNK_SUMMARY_MODEL=gemini-2.5-flash-lite
AI_SUMMARY_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_SUMMARY_MODEL=gpt-4.1-mini
AI_CHAT_MODEL=gpt-4.1-mini
AI_FALLBACK_CHAT_MODEL=gemini-2.5-flash
